{
  "buildCommand": "cd careweave/client && npm install --include=optional && npm run build",
  "outputDirectory": "careweave/client/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://hacktoberfest-rfpw.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
