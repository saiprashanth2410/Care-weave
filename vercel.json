{
  "buildCommand": "cd careweave/client && npm install --include=optional @rolldown/binding-linux-x64-gnu && npm run build",
  "outputDirectory": "careweave/client/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
