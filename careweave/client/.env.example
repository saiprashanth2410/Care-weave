# Firebase web app configuration (Firebase console > Project settings > General > Your apps > Web app).
# These values identify the project. They are not secrets, but keep .env out of git anyway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=hacktober-143c4.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=hacktober-143c4
VITE_FIREBASE_STORAGE_BUCKET=hacktober-143c4.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Video consultation relay (TURN). Without it the call is browser to browser through Google's free STUN servers, which fails on some
# networks (strict college or hospital Wi-Fi, some mobile carriers). A TURN relay carries the (still encrypted) media when a direct path
# is blocked. Get free credentials from a TURN provider, set all three, then rebuild and redeploy: these are build-time variables.
# VITE_TURN_URL="turn:YOUR_TURN_HOST:80,turns:YOUR_TURN_HOST:443?transport=tcp"
# VITE_TURN_USERNAME=""
# VITE_TURN_CREDENTIAL=""
