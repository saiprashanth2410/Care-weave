# Copy to .env and fill in. Never commit .env.
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Local MongoDB (works on any network):
MONGODB_URI="mongodb://127.0.0.1:27017"
# Or MongoDB Atlas (needs outbound port 27017 and your IP on Network Access):
# MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net"
MONGODB_DB="careweave"
# Production needs MongoDB. Without MONGODB_URI the server uses data/careweave.json (development only, single process);
# in production that is refused unless ALLOW_LOCAL_STORE=true.
# ALLOW_LOCAL_STORE=true

# Report scanning (server-side only)
GEMINI_API_KEY=""
# GEMINI_MODEL="gemma-4-31b-it"  (optional, tried first). Default: Gemma 4, then Gemini Flash if Gemma is busy.

# Firebase Authentication (staff sign-in). The server verifies ID tokens for this project.
# FIREBASE_PROJECT_ID="hacktober-143c4"
# Set to false only after turning off sign-up in Firebase Authentication settings.
# FIREBASE_REQUIRE_VERIFIED_EMAIL=true
# Keep local password sign-in alongside Firebase (development only).
# ALLOW_LOCAL_LOGIN=true

# Exasol Personal Analytics Data Platform
# Install via Exasol Launcher on macOS: curl https://downloads.exasol.com/exasol-personal/installer.sh | sh
EXASOL_HOST="localhost"
EXASOL_PORT=8563
EXASOL_USER="sys"
EXASOL_PASSWORD="your-exasol-password"
EXASOL_SCHEMA="CAREWEAVE_ANALYTICS"


# WhatsApp
# Shared key that n8n and Twilio calls must present (header x-api-key or ?key=). Required in production.
# WHATSAPP_API_KEY=""
# Meta Cloud API: the app secret verifies X-Hub-Signature-256 on webhook calls (production refuses Meta calls without it),
# and the verify token answers Meta's one-time handshake.
# META_APP_SECRET=""
# META_VERIFY_TOKEN=""

# Tests that use MongoDB run against this (a throwaway database). Default: mongodb://127.0.0.1:27017
# CAREWEAVE_TEST_MONGODB_URI=""

# Analytics: run the incremental Exasol sync every N minutes (a running server), or call GET /api/analytics/cron with
# "Authorization: Bearer <CRON_SECRET>" from a scheduler (serverless). Both are off when unset.
# ANALYTICS_SYNC_MINUTES=15
# CRON_SECRET=
# With Exasol offline the overview covers this many recent days (default 90).
# ANALYTICS_WINDOW_DAYS=90
