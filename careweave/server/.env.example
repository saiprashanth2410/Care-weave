# Copy to .env and fill in. Never commit .env.
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Local MongoDB (works on any network):
MONGODB_URI="mongodb://127.0.0.1:27017"
# Or MongoDB Atlas (needs outbound port 27017 and your IP on Network Access):
# MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net"
MONGODB_DB="careweave"

# Report scanning (server-side only)
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-3.8-flash"  (optional, tried first)

# Report scanning with Claude (used first when set). Get a key at console.anthropic.com
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-opus-5-5"   # or claude-haiku-5-5 for a cheaper scanner
# SCAN_PROVIDER="gemini"            # force Gemini even when an Anthropic key is set
